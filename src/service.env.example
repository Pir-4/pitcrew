# Config of the Pitcrew service (src/pitcrew/config/settings.py), filled by `make create-service-env`.
# Separate from the root .env, which belongs to the development agent and is never read by the
# service. Real environment variables override this file; at deploy Helm injects them instead.
#
# One `NAME=default` line per variable, each with a comment above it saying what it is for (and,
# for a token, where to generate it). Values go without quotes: `docker run --env-file` keeps
# them literally.

# Bearer token the callers of POST /triggers and GET /run-chains/{id} (`make trigger`,
# `make run-status`, later the CI step of qa_automation) must send. Any long random string,
# e.g. `openssl rand -hex 32`. Required.
PITCREW_TRIGGER_TOKEN=

# Base URL of Allure TestOps, where Pitcrew reads the launches and their test results. Required.
ALLURE_ENDPOINT=https://testops.ston.fi

# Allure TestOps API token, sent as `Authorization: Api-Token <token>`. Generate at
# https://testops.ston.fi/ -> profile -> API tokens. Required.
ALLURE_TOKEN=

# Base URL of GitLab, where Pitcrew creates the Rerun pipelines of qa_automation. Required.
GITLAB_URL=https://gitlab.ston.fi

# GitLab personal access token with the `api` scope and Developer access to qa_automation (it
# creates pipelines there), sent as `PRIVATE-TOKEN`. Generate at
# https://gitlab.ston.fi/-/user_settings/personal_access_tokens. Required.
GITLAB_TOKEN=

# Slack incoming webhook of the Gateway channel, where Pitcrew posts its Conclusions; named
# by `slack.webhook_variable` in config/gateway.yaml. The URL is the secret. Create at
# https://api.slack.com/apps -> your app -> Incoming Webhooks. Required while Gateway has
# the `conclusion` feature.
SLACK_WEBHOOK_GATEWAY=

# SQLAlchemy URL of the Run chain DB. Locally a SQLite file in the working directory; MySQL at
# deploy. The schema is migrated on startup. Required.
DATABASE_URL=sqlite:///pitcrew.db

# Directory with the Team configs: base.yaml and <team lowercased>.yaml.
PITCREW_CONFIG_DIR=config

# Where Pitcrew keeps the clone of qa_automation, the Working copies of the Agent tasks and the
# Agent's Claude state (sessions). Locally a git-ignored directory; a volume at deploy.
PITCREW_WORK_DIR=var/workspace

# Base URL of the internal LiteLLM, the only way the Agent reaches a model.
LITELLM_URL=https://litellm.ston.fi

# LiteLLM key, sent by the Agent as a bearer token. Create one in the LiteLLM UI under
# Settings -> API keys. Optional: the service starts without it, `make agent-smoke` fails naming it.
LITELLM_KEY=

# The pool of the Agent's models, as LiteLLM names them (the LiteLLM admins announce the
# current ids): a junior, a middle and a senior one. What an Agent task is for decides its tier, e.g.
# `make agent-smoke` asks the junior one.
AGENT_MODEL_JUNIOR=claude-haiku-5-5
AGENT_MODEL_MIDDLE=claude-sonnet-5-5
AGENT_MODEL_SENIOR=claude-opus-5-5

# The most turns (a model answer and the tool results it asked for) an Agent task may take;
# the Agent stops on the limit and the task ends unfinished.
AGENT_MAX_TURNS=30

# The most an Agent task may cost, in USD, as the SDK estimates it on the client side (LiteLLM
# bills on its own); the Agent stops once over it.
AGENT_MAX_BUDGET_USD=1.0

# The wall-clock time of an Agent task, in seconds: Pitcrew stops the Agent's process after it.
AGENT_TIMEOUT_SECONDS=600

# Log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Log format: `json` (one JSON object per line on stdout, what the cluster's log stack picks
# up) or `console` (coloured lines for a human). `make run` sets `console` itself.
LOG_FORMAT=json
