## ATLASSIAN ##
# Jira read access for the agent. Token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_URL=https://stonfi.atlassian.net/
ATLASSIAN_EMAIL=
ATLASSIAN_TOKEN=

## GITLAB ##
# Used by the SessionStart hook (glab auth login) and the gitlab-mr / gitlab-issue skills.
# Token scope: api. Generate at: https://gitlab.ston.fi/-/user_settings/personal_access_tokens
GITLAB_HOST=gitlab.ston.fi
GITLAB_TOKEN=

## ALLURE TESTOPS ##
# Used by the allure-testops MCP server declared in .mcp.json.
# Generate at: https://testops.ston.fi/ -> profile -> API tokens
ALLURE_TOKEN=
